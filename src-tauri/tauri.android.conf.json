{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mockup Studio",
  "version": "../package.json",
  "identifier": "dev.shirsendu-bairagi.mockup-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "dotenvx run -f .env.native -- vp dev",
    "beforeBuildCommand": "dotenvx run -f .env.native -- vp build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": []
  },
  "plugins": {}
}