{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:default",
    "fs:default",
    "fs:allow-temp-read-recursive",
    "fs:allow-temp-write-recursive",
    "dialog:default"
  ]
}