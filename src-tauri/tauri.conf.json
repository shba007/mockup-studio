{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mockup Studio",
  "version": "../package.json",
  "identifier": "dev.shirsendu-bairagi.mockup-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "dotenvx run -f .env.native -- vp dev",
    "beforeBuildCommand": "dotenvx run -f .env.native -- vp build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": true,
        "url": "/",
        "title": "Mockup Studio",
        "width": 1400,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQTUyQTk1RTQwNzU0NkEKUldScVZBZmtsU3FsOGxsVHdWenVkem50OTJ2VXRBSCtubHE5c0JGcU9hS2swa3l1U0d5dDArL0oK",
      "endpoints": ["https://github.com/shba007/mockup-studio/releases/latest/download/latest.json"]
    }
  }
}