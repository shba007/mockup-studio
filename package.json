{
  "name": "mockup-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "vp fmt src/",
    "prepare": "vp config",
    "render:preview": "vp build && vp preview",
    "render:export": "bun run render.ts"
  },
  "dependencies": {
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "@tresjs/post-processing": "^3.7.4",
    "execa": "^10.0.1",
    "jszip": "^3.10.1",
    "three": "^0.185.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plus": "0.2.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "engines": {
    "bun": "^1.4.0",
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "bun@1.4.0"
}
